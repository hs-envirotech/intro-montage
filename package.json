{
  "name": "envirotech_intro",
  "version": "1.0.0",
  "private": true,
  "description": "Envirotech 60-second corporate intro video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts EnvirotechIntro out/envirotech_intro_v3.mp4 --props=props/final.json",
    "render:review": "remotion render src/index.ts EnvirotechIntro out/envirotech_intro_v3_review.mp4 --props=props/review.json",
    "score": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/compose_score.mts",
    "typecheck": "tsc --noEmit",
    "render:gpu": "remotion render src/index.ts EnvirotechIntro out/envirotech_intro_v3.mp4 --props=props/final.json --gl=angle"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@react-three/fiber": "^9.8.1",
    "@remotion/cli": "^4.0.529",
    "@remotion/fonts": "^4.0.529",
    "@remotion/three": "^4.0.529",
    "@remotion/zod-types": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
