{
  "name": "muse-rig",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MUSE RIG — Pocket Guitar. A touchscreen virtual electric guitar PWA (Phase 1: Fury).",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
